<?xml version="1.0" encoding="utf-8"?>
<mujoco>
    <!-- Meshes and textures symlinked from gymnasium_robotics package -->
    <compiler angle="radian" coordinate="local" meshdir="fetch" texturedir="textures"></compiler>
    <option timestep="0.002">
        <flag warmstart="enable"></flag>
    </option>

    <!-- Include shared definitions (copied to this directory) -->
    <include file="shared.xml"></include>

    <worldbody>
        <geom name="floor0" pos="0.8 0.75 0" size="0.85 1.05 1" type="plane" condim="3" material="floor_mat"></geom>
        <body name="floor0" pos="0.8 0.75 0">
        </body>

        <!-- Goal visualization - red sphere positioned in world coordinates -->
        <site name="target0" pos="1.3 0.75 0.5" size="0.04 0.04 0.04" rgba="1 0 0 0.8" type="sphere"></site>

        <include file="robot.xml"></include>

        <!-- Custom camera for better view -->
        <camera name="obstacles_view" pos="1.3 0.4 1.2" xyaxes="1 0 0 0 1 1" mode="fixed"></camera>

        <!-- Table (no walls) - 1.5x longer in y-direction -->
        <body pos="1.3 0.75 0.2" name="table0">
            <geom size="0.25 0.525 0.2" type="box" mass="2000" material="table_mat"></geom>
        </body>

        <!-- 10 Obstacle boxes (will be positioned dynamically) -->
        <!-- Each obstacle is a box that will be placed on the table -->
        <body pos="1.3 0.75 0.45" name="obstacle0">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle0"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle1">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle1"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle2">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle2"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle3">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle3"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle4">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle4"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle5">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle5"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle6">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle6"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle7">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle7"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle8">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle8"></geom>
        </body>
        
        <body pos="1.3 0.75 0.45" name="obstacle9">
            <geom size="0.05 0.05 0.03" type="box" rgba="0.4 0.4 0.4 1" mass="1000" name="obstacle9"></geom>
        </body>

        <light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="false" pos="0 0 4" dir="0 0 -1" name="light0"></light>
    </worldbody>

    <actuator>
        <!-- Position actuators for gripper fingers -->
        <position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="30000" name="robot0:l_gripper_finger_joint" user="1"></position>
        <position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="30000" name="robot0:r_gripper_finger_joint" user="1"></position>
    </actuator>
</mujoco>
